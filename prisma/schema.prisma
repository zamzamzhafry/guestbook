model Guest {
  id           String   @id @default(uuid()) @map("UUID")
  name         String   @map("Name")
  email        String   @unique @map("Email")
  whatsapp     String   @map("NoWhatsapp")
  code         String   @map("Kode")
  guestCount   Int      @map("Jml")
  dateModified DateTime @updatedAt @map("Date_Modified")
  dateAdded    DateTime @default(now()) @map("Date_Added")
  isDeleted    Boolean  @default(false) @map("IsDeleted")
  weddingId    String?  @map("WeddingId")
  status       Int      @default(0)
  wedding      Wedding? @relation(fields: [weddingId], references: [id])
  wish         Wish?
}

model Wish {
  id       String @id @default(uuid()) @map("UUID")
  guestId  String @unique @map("GuestId")
  message  String @map("Wish")
  donation Float? @map("Donate")
  guest    Guest  @relation(fields: [guestId], references: [id])
}
