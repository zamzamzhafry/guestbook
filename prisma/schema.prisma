datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Wedding {
  id             String   @id @default(uuid()) @map("UUID")
  brideName      String   @map("BrideName")
  groomName      String   @map("GroomName")
  date           DateTime @map("Date_Wedding")
  location       String   @map("Location")
  mapsLink       String   @map("Link_Maps")
  streamingLink  String   @map("Link_Streaming")
  websiteLink    String   @map("Link_Website")
  groomParent    String   @map("GroomParent")
  brideParent    String   @map("BrideParent")
  hashtag        String   @map("Hastag")
  brideSocial    String   @map("Bride_Social")
  brideSocialURL String   @map("Bride_SocialURL")
  groomSocial    String   @map("Groom_Social")
  groomSocialURL String   @map("Groom_SocialURL")
  guests         Guest[]
}

